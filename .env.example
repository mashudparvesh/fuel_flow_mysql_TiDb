MYSQL_PORT="4000"
MYSQL_USER="3vs45pD8HohQ35M.root"
MYSQL_PASSWORD="FaiamIkyLcN3kABc"
MYSQL_DATABASE="test"
MYSQL_SSL="true"
DATABASE_URL="mysql://3vs45pD8HohQ35M.root:FaiamIkyLcN3kABc@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/test?ssl=true"

